# ============================================================================
# 律师专用多 Agent 法律咨询助手 —— 环境配置样例
# 复制为 .env 后按部署环境修改。所有键均与 backend/app/config.py 的 Settings 字段一一对应，
# 启动时若发现未映射的键会打印 WARN（避免「配了但没生效」的静默失效）。
# ============================================================================

# ---------------------------------------------------------------- 基础
APP_NAME=律师专用多 Agent 法律咨询助手
APP_VERSION=1.0.0
ENV=dev
DEBUG=true
SECRET_KEY=change-me-in-production-legal-agent
ACCESS_TOKEN_EXPIRE_MINUTES=720
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
WORKERS=1
SERVE_WEB=true
CORS_ORIGINS=*

# ---------------------------------------------------------------- 模型推理（H20 + SGLang）
# auto: 依次尝试 openai 兼容 -> ollama -> 离线兜底
LLM_PROVIDER=auto
LLM_BASE_URL=http://127.0.0.1:30000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3-8b-legal-lora
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_ENABLE_THINKING=false

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 多模态（扫描件 / 手写批注 / 结构图）
VLM_ENABLED=true
VLM_BASE_URL=http://127.0.0.1:30001/v1
VLM_API_KEY=EMPTY
VLM_MODEL=qwen2.5-vl-7b
VLM_TIMEOUT=90

# ---------------------------------------------------------------- 向量检索
EMBEDDING_PROVIDER=auto
EMBEDDING_BASE_URL=http://127.0.0.1:30000/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_BATCH=32
# 可选：填写本机已下载的 sentence-transformers BGE 模型目录。
EMBEDDING_LOCAL_MODEL_PATH=
# 可选：填写本机已下载的 bge-reranker CrossEncoder 模型目录。
RERANKER_LOCAL_MODEL_PATH=

MILVUS_ENABLED=true
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB=legal_agent
MILVUS_COLLECTION_STATUTE=legal_statute
MILVUS_COLLECTION_CASE=legal_case
MILVUS_COLLECTION_KNOWLEDGE=legal_knowledge
MILVUS_COLLECTION_MEMORY=legal_memory
VECTOR_FALLBACK_TO_LOCAL=true

# ---------------------------------------------------------------- 关键词检索（BM25）
BM25_ENABLED=true
# whoosh = 默认（Milvus 向量 + Whoosh BM25 混合检索）；builtin = 内置纯 Python 兜底
BM25_ENGINE=whoosh
BM25_INDEX_DIR=./data/index/bm25
BM25_K1=1.5
BM25_B=0.75
RETRIEVE_TOP_K=20
RERANK_TOP_K=6
RRF_K=60

# ---------------------------------------------------------------- A2A 多 Agent 协同
# in_process = 同进程委派（默认）；http = 委派到独立部署的 Agent 实例
A2A_TRANSPORT=in_process
# http 通道下必填：对方实例的地址（它会用 /api/v1/a2a/remote/{agent} 接住）
A2A_REMOTE_BASE=
A2A_TIMEOUT_MS=30000
# 对方实例的 Bearer 令牌；留空表示内网互信
A2A_TOKEN=

# ---------------------------------------------------------------- 存储
DB_ENABLED=true
DB_URL=mysql+pymysql://root:123456@127.0.0.1:3306/legal_agent?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SQLITE_FALLBACK_URL=sqlite:///./data/legal_agent.db

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TTL_SECONDS=86400

RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
RABBITMQ_QUEUE=legal_agent.tasks

# 任务 worker（backend/worker/app.py）
# POLL_SECONDS 是"入队到开始跑"的延迟上限；有 broker 时它只作为兜底间隔。
WORKER_POLL_SECONDS=5.0
# 一次轮询认领的条数 = 单 worker 的并发度
WORKER_BATCH=4
# 单任务硬超时（秒），0 表示不限。不限的代价是卡死的任务永久占住并发名额
WORKER_TASK_TIMEOUT=1800.0
# "卡死在 running"的判定阈值（秒）。0 = 自动取 WORKER_TASK_TIMEOUT 的两倍。
# 不要设得比任务超时小，否则正在跑的长任务会被当成卡死并放回队列，导致重复执行
WORKER_STALE_SECONDS=0.0

# ---------------------------------------------------------------- 业务参数（防死循环）
# 步数上限：方案 4.3 原文是「max_steps = 6~8，超限即停」，这里取 16，理由：
#   · 最长单趟路径 contract_review = 1（Intent）+ 8（Intake/Statute/Case/Knowledge/
#     Review/Validator/Draft/Report）= 9 步，按 8 设限时 ReportNode 根本跑不到；
#   · 方案同时要求「Validator 失败回环」，回环需重跑 5 个节点，
#     预算检查 steps + len(rerun) <= MAX_STEPS 在 8 时恒不成立，回环会变成死代码。
# 按 6~8 设限的后果不是更安全，而是**每一单合同审查都报「预算耗尽」**，
# 并把这条噪声灌进报告的证据缺口清单，让律师不再信任整份清单。
# 16 = 最长路径 9 + 一次完整回环 5 + 2 步余量。
MAX_STEPS=16
TOOL_TIMEOUT=30
TOOL_MAX_RETRY=2
TOOL_RETRY_BACKOFF=0.5
STATUTE_SEARCH_MAX_CALLS=3
CASE_SEARCH_MAX_CALLS=2
CITATION_MIN_CONFIDENCE=0.6
EVIDENCE_GAP_ALERT_RATIO=0.34

# ------------------------------------------------------- 合同审查扫描并发
# 逐条风险扫描是整单最慢的一步：一次全量扫描 25 条款实测 57~76s，瓶颈在输出
# token 而不是检索。按 8 条切块并发后墙钟≈最慢的那一块（实测 67.2s → 49.2s）。
# REVIEW_SCAN_CHUNK_CLAUSES=0 表示关掉分块，退回"一次全量扫描"。
REVIEW_SCAN_CHUNK_CLAUSES=8
# 并发上限：块数通常 2~4，取 4 让它们一波发完，别排队等第二波。
REVIEW_SCAN_CONCURRENCY=4

# ---------------------------------------------------------------- 合规
DISCLAIMER=本内容由 AI 辅助生成，仅供律师工作参考，不构成正式法律意见。
DESENSITIZE_ENABLED=true
AUDIT_ENABLED=true
AUDIT_LOG_DIR=./data/audit
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
PROCESSED_DIR=./data/processed
RAW_DIR=./data/raw
KNOWLEDGE_DIR=./data/knowledge
MAX_UPLOAD_MB=200
CLIENT_PERSIST_LOCAL=false

# ------------------------------------------------------------ 微信机器人接入
# 律师在微信里上传证据材料、生成证据链。
#
# 分工：**法律逻辑全在本服务**（案件隔离、诉讼/非诉准入、材料登记、证据链生成），
# 微信机器人（WeChat-AI）只做搬运 —— 它把消息 POST 到
# /api/v1/wechat/events，再把这里回的几句话发回微信。
#
# 未开启时该接口返回 503（不是 404）。要真正可用，下面**两项都要配**：
# WECHAT_ENABLED 与 WECHAT_BRIDGE_TOKEN 缺任一都是"配了不生效"。
WECHAT_ENABLED=false
# 桥接共享密钥。机器人侧用 X-Bridge-Token 头带上它。
# **留空 = 接口关闭**（不设"空密钥就放行"）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 必须与机器人侧 .env 的 LEGAL_BRIDGE_TOKEN 一致。
WECHAT_BRIDGE_TOKEN=
# 绑定码有效期（分钟）。律师在 Web 工作台「证据链」页取码，在微信里发 /绑定 <码>。
WECHAT_BIND_CODE_TTL_MINUTES=15
# 微信单条消息能带的附件上限（整体）与单文件上限（MB）。
WECHAT_MAX_ATTACHMENTS=10
WECHAT_MAX_ATTACHMENT_MB=20

# ---------------------------------------------------------------- 初始账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DEMO_LAWYER_USERNAME=lawyer
DEMO_LAWYER_PASSWORD=lawyer123

# 部署配置模板（容器编排用）—— 请复制为 deploy/.env 后再改
#
#   cp deploy/.env.example deploy/.env
#
# **为什么不再是根目录那份 .env。** 根目录的 .env 是本机开发配置：
# DEBUG=true、SECRET_KEY=change-me-in-production-legal-agent、
# ADMIN_PASSWORD=admin123、RABBITMQ_ENABLED=false。容器里挂它进来，
# 等于把一份公开的示例值当成生产配置跑 —— 而且因为那份文件里 ENV=dev，
# 连代码里「出厂密钥」那条告警都不会触发。
#
# **没有这个文件会发生什么。** docker-compose.yml 里 SECRET_KEY 与
# ADMIN_PASSWORD 用的是 Compose 的必需变量语法（${VAR:?提示}）：
# 缺失时 `docker compose up` **直接失败**并打印提示，不会静默回落默认值。
# 这是刻意的 —— "部署前请修改默认口令"写进文档里没人看，写进报错里才拦得住。

# ------------------------------------------------------------------ 必填
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 必须至少 32 字节（RFC 7518 §3.2 对 HMAC-SHA256 的建议下限）。
# **改这个值会让所有已签发令牌立刻失效**，表现为全所同时掉线 —— 属预期，
# 挑业务低峰做。
SECRET_KEY=

# 初始管理员口令。示例值 admin123 是公开的，不得使用。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 演示律师账号（不需要就整段删掉，或改成与管理员不同的口令）
DEMO_LAWYER_USERNAME=lawyer
DEMO_LAWYER_PASSWORD=

# ------------------------------------------------------------------ 服务凭证
# 这三个必须与 docker-compose.yml 里 mysql / rabbitmq 的 *_PASSWORD 一致，
# 否则现象是"容器都在跑但连不上"，而报错是数据库侧的鉴权失败，
# 很容易查成网络问题。
MYSQL_USER=legal
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=legal_agent
MYSQL_ROOT_PASSWORD=changeme
# rabbitmq 默认进了 broker profile（不随默认组合启动）。要开：
#   1) 先装依赖：pip install aio-pika（requirements.txt 里那行现在是被注释的）
#   2) 重建镜像，再 docker compose --profile broker up -d
# 不加这一步就设 RABBITMQ_ENABLED=true 的话，worker 会打印"未安装 aio-pika，
# 回落为轮询"并继续用数据库轮询 —— 不丢活，只是白慌一次。
RABBITMQ_ENABLED=false
RABBITMQ_USER=legal
RABBITMQ_PASS=changeme

# ------------------------------------------------------------------ 模型
# 默认 profile 不启 GPU 推理，留空即可（代码会走规则引擎兜底）；
# 用 --profile gpu 时改为 http://sglang:30000/v1
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3-8b-legal-lora
VLM_ENABLED=false

EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# 容器内 embedding 走 CPU 推理；若接了 torch + GPU 版本镜像再改。

# 向量库：默认 profile 没有 milvus 服务，所以默认关闭。
# 要用 --profile vector 启动时，这里改 true（同时 CI/CD 里别忘加 profile 参数）。
MILVUS_ENABLED=false

# ------------------------------------------------------------------ 网关
# 与 compose 里 web 的 ports 映射保持一致。填错的效果是登录成功立刻跳回登录框
# （cookie 的 domain/path 对不上），非常容易误判成 session 失效。
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080

# ------------------------------------------------------------------ 业务
MAX_STEPS=16
STATUTE_SEARCH_MAX_CALLS=3
CASE_SEARCH_MAX_CALLS=2
DESENSITIZE_ENABLED=true
AUDIT_ENABLED=true
